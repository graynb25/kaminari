{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kaminari",
  "version": "0.10.0",
  "identifier": "app.kaminari.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Kaminari",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": false,
        "fullscreen": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' asset: http://asset.localhost ipc: https: blob:; img-src 'self' asset: http://asset.localhost https: data:; media-src https: blob: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Entertainment",
    "shortDescription": "Aniyomi, but for PC."
  }
}
